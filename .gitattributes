# Ocultar todo el código generado para plataformas nativas
android/**/* linguist-vendored
ios/**/* linguist-vendored
web/**/* linguist-vendored
windows/**/* linguist-vendored
macos/**/* linguist-vendored
linux/**/* linguist-vendored

# Ocultar archivos de configuración de Flutter y paquetes de dependencias
.metadata linguist-vendored
.packages linguist-vendored
.flutter-plugins linguist-vendored
.flutter-plugins-dependencies linguist-vendored
pubspec.lock linguist-vendored

# Por si las dudas, ignorar archivos específicos de C++ en cualquier subcarpeta nativa
*.cpp linguist-vendored
*.h linguist-vendored
*.cc linguist-vendored

# Ocultar archivos de configuración de CMake
*cmake* linguist-vendored
*.cmake linguist-vendored
CMakeLists.txt linguist-vendored

# Por si acaso, ocultar también archivos de configuración de Gradle (Android) o CocoaPods (iOS)
*.gradle linguist-vendored
*.properties linguist-vendored
Podfile* linguist-vendored
